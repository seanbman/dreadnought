{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/seanbman/dreadnought/schemas/protocol.schema.json",
  "title": "Dreadnought Protocol Record",
  "type": "object",
  "required": ["id", "kind", "perspective", "actor_id", "created_at", "schema_version", "data", "evidence_refs"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "kind": {"enum": ["claim", "observation", "action", "artifact", "requirement", "risk", "note", "verdict"]},
    "perspective": {"enum": ["human_source", "agent", "observer", "evaluation"]},
    "actor_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "schema_version": {"const": 1},
    "mission_ref": {"type": ["string", "null"]},
    "doctrine_ref": {"type": ["string", "null"]},
    "order_ref": {"type": ["string", "null"]},
    "subject_ref": {"type": ["string", "null"]},
    "data": {"type": "object"},
    "evidence_refs": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {"properties": {"kind": {"const": "claim"}}, "required": ["kind"]},
      "then": {
        "properties": {"perspective": {"const": "agent"}},
        "required": ["subject_ref"]
      }
    },
    {
      "if": {"properties": {"kind": {"const": "observation"}}, "required": ["kind"]},
      "then": {"properties": {"perspective": {"const": "observer"}}}
    },
    {
      "if": {"properties": {"kind": {"const": "verdict"}}, "required": ["kind"]},
      "then": {
        "properties": {"perspective": {"const": "evaluation"}},
        "required": ["subject_ref"]
      }
    }
  ]
}
